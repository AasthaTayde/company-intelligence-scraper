{
  "name": "company-intelligence-scraper",
  "version": "1.0.0",
  "description": "A configurable company website scraper with CSV/JSON export, logging, tests, and data-quality reporting.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "scrape": "node src/cli.js",
